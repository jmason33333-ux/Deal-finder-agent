# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Google Sheets (Apps Script web app URL — see config/apps_script.gs for setup)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Flippa (API key if available, otherwise uses scraping)
FLIPPA_API_KEY=

# Logging
LOG_LEVEL=INFO
